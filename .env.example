# Local development only. Copy to .env and replace the password.
POSTGRES_DB=smart_university_scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/smart_university_scheduler
BACKEND_PORT=8080
FRONTEND_PORT=5173
# Used only by Vite's server-side development proxy, never bundled into the browser.
BACKEND_PROXY_TARGET=http://localhost:8080
# Required: Base64 encoding of at least 32 cryptographically random bytes.
# No default signing key. See docs/api.md for generation commands.
JWT_SECRET_BASE64=
SOLVER_MAX_TIME_MILLIS=3000
SOLVER_MAX_GROUPS=100
SOLVER_MAX_OPTIONS=5000
JWT_ISSUER=smart-university-scheduler
JWT_AUDIENCE=smart-university-scheduler-api
JWT_TTL_SECONDS=900
# Optional AI advisor. Keep the key on the backend; never use VITE_* for secrets.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
