{
  "name": "smart-university-scheduler",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "engines": { "node": ">=22.12.0 <23", "npm": ">=10 <11" },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
